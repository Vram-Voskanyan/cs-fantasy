// cs-vv-fantasy: one Worker per environment. Next.js (OpenNext) serves HTTP;
// worker.ts adds the cron (data sync) and the scoring queue consumer.
// Resource IDs: docs/CLOUDFLARE.md
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cs-vv-fantasy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cs-vv-fantasy" }],
  // Schedule sync every 6 hours. The live loop (every minute) is added in M2.
  "triggers": { "crons": ["0 */6 * * *"] },
  "vars": { "APP_URL": "https://cs-vv-fantasy.vram-arm.workers.dev", "APP_ENV": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cs-vv-fantasy-db",
      "database_id": "cf6db5c6-71a6-4297-b854-7c2f35b99a60",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "ef72e9485ffd4407ab0f6883473dd73b" }],
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "cs-vv-fantasy-assets" }],
  "queues": {
    "producers": [{ "binding": "SCORING_QUEUE", "queue": "cs-vv-fantasy-scoring" }],
    "consumers": [
      {
        "queue": "cs-vv-fantasy-scoring",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "cs-vv-fantasy-scoring-dlq"
      }
    ]
  },
  "env": {
    "staging": {
      "name": "cs-vv-fantasy-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cs-vv-fantasy-staging" }],
      "triggers": { "crons": ["0 */6 * * *"] },
      "vars": { "APP_URL": "https://cs-vv-fantasy-staging.vram-arm.workers.dev", "APP_ENV": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cs-vv-fantasy-db-staging",
          "database_id": "99f9a5de-2fb0-476a-bd0c-1d2eb5d80241",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CACHE", "id": "b99a6153f41d4b268f1073d32a97efd8" }],
      "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "cs-vv-fantasy-assets-staging" }],
      "queues": {
        "producers": [{ "binding": "SCORING_QUEUE", "queue": "cs-vv-fantasy-scoring-staging" }],
        "consumers": [
          {
            "queue": "cs-vv-fantasy-scoring-staging",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "cs-vv-fantasy-scoring-dlq-staging"
          }
        ]
      }
    }
  }
}
