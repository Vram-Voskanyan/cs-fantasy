{
  "name": "cs-vv-fantasy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cs-vv-fantasy/web",
    "preview": "npm run preview -w @cs-vv-fantasy/web",
    "build": "npm run build -w @cs-vv-fantasy/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "npm run generate -w @cs-vv-fantasy/db --",
    "db:migrate:local": "npm run db:migrate:local -w @cs-vv-fantasy/web",
    "deploy:staging": "npm run db:migrate:staging -w @cs-vv-fantasy/web && npm run deploy:staging -w @cs-vv-fantasy/web",
    "deploy:production": "npm run db:migrate:production -w @cs-vv-fantasy/web && npm run deploy -w @cs-vv-fantasy/web",
    "admin:grant": "node scripts/grant-admin.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
